<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./styles.css">
    <title>Mini Messageboard</title>
</head>
<body>
    <form method="POST" action="/new">
        <h1>Add a new message!</h1>
        <input name="message" type="text" placeholder="put message here">
        <button type="submit">Send!</button>
    </form>
    <% for (let i = messages.length - 1; i >= 0; i--) { %>
        <div class="message-card">
            <h1> <%= messages[i].username %> (<%= new Date(messages[i].timesent).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>) </h1>
            
            <p> <%= messages[i].message %> </p>
        </div>
    <% } %>
</body>
</html>
